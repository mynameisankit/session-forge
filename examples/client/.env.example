# Copy to .env.local to customize. Restart Vite after changing these values.
# BACKEND_URL configures the Vite proxy and is not exposed to the browser.
BACKEND_URL=http://127.0.0.1:3000
VITE_EXAMPLE_NAME=SessionForge example
# Set to http to use a backend with the default dev command as well.
# VITE_AUTH_MODE=http
