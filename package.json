{
  "name": "session-forge",
  "packageManager": "yarn@4.18.0",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "client": "yarn workspace session-forge-example-client dev",
    "client:backend": "yarn workspace session-forge-example-client dev:backend"
  },
  "workspaces": [
    "examples/*"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
